# LinkedIn Developer App credentials (https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# OAuth tokens — populated by `npm run get-token` once
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_USER_URN=

# --- Draft-by-email approval flow ---
# Resend (email). Free tier can only send to the account owner's address.
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=onboarding@resend.dev

# Shared secret used to sign the "Aprobar y publicar" link.
# MUST be identical here, in GitHub Secrets, and in Vercel env. Generate with:
#   openssl rand -hex 32
APPROVE_SECRET=

# Base URL of the Vercel deployment hosting /api/approve and /api/publish.
APPROVE_BASE_URL=https://codex-engine.vercel.app

# GitHub PAT (fine-grained, Actions: read+write on this repo). Vercel-only —
# lets /api/publish trigger the publish.yml workflow. Do NOT put in GitHub.
GH_DISPATCH_TOKEN=

# owner/name of the repo (used by the Vercel endpoints).
REPO=martomartomarto/codex-engine
