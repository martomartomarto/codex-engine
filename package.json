{
  "name": "codex-engine",
  "version": "0.2.0",
  "private": false,
  "description": "The engine that posts to my LinkedIn.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "get-token": "tsx scripts/get-token.ts",
    "post": "tsx scripts/post.ts",
    "post:dry": "tsx scripts/post.ts --dry-run",
    "send-draft": "tsx scripts/send-draft.ts",
    "ideas": "tsx scripts/weekly-ideas.ts",
    "intel": "node scripts/intel-sweep.mjs",
    "intel:dry": "node scripts/intel-sweep.mjs --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
